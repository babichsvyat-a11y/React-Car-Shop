{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "../frontend_next/src/shared/types/totalAuto.interface.ts",
    "../frontend_next/src/hooks/useCartReducer.ts",
    "../frontend_next/src/store/store.ts",
    "../frontend_next/src/store/cartSlice.ts",
    "../frontend_next/src/components/CompList.tsx",
    "../frontend_next/src/components/CarList.tsx"
  ]
}
